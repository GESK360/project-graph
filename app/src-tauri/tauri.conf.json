{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flux Graph",
  "version": "4.5.2",
  "identifier": "liren.project-graph",
  "build": {
    "beforeDevCommand": "pnpm --filter @graphif/project-graph dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "node ./scripts/prepare-bundle.js",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flux Graph",
        "url": "/index.html",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "rpm", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "longDescription": "Flux Graph: a desktop node-graph tool for visual thinking, knowledge mapping and project planning.",
    "shortDescription": "Flux Graph node-graph editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "TradChinese", "English", "Indonesian"],
        "sidebarImage": "nsis/left.bmp",
        "headerImage": "nsis/project-graph-install.bmp",
        "installerHooks": "nsis/installer.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 720, "height": 460 },
        "appPosition": { "x": 184, "y": 254 },
        "applicationFolderPosition": { "x": 536, "y": 254 }
      }
    },
    "fileAssociations": [
      {
        "name": "Flux Graph Document",
        "description": "Flux Graph Document",
        "ext": ["prg"],
        "mimeType": "application/vnd.project-graph",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["prg", "flux"]
      }
    },
    "cli": {
      "description": "Flux Graph: a desktop node-graph tool for visual thinking.",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "output",
          "short": "o",
          "takesValue": true,
          "multiple": false
        },
        {
          "name": "size",
          "short": "s",
          "takesValue": true,
          "multiple": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQzM3OTE1QjgwRTRCNzEKUldSeFN3NjRGWG5Ec2hVb05sWGZhVmpJdEVCR2cwNmM4UXlISEN5eHJBeFlCQkF3VjV6Z0tEY08K",
      "endpoints": ["https://release.project-graph.top/update/{{target}}/{{arch}}/{{current_version}}"],
      "windows": {
        "installMode": "passive"
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": ".*"
    }
  }
}
